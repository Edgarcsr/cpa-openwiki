# Obrigatório em produção: string aleatória longa (openssl rand -base64 32).
BETTER_AUTH_SECRET=
# URL pública do site (usada nos cookies e redirecionamentos).
BETTER_AUTH_URL=http://localhost:3000
# Outros endereços que podem fazer login (separados por vírgula), se necessário.
BETTER_AUTH_TRUSTED_ORIGINS=
# "closed" trava novos cadastros. O primeiro usuário sempre vira admin.
OPENWIKI_SIGNUP=open
